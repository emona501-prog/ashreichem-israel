<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:layoutDirection="rtl" android:background="@drawable/widget_bg" android:padding="9dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <ImageView android:id="@+id/w_logo" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/widget_logo" android:scaleType="fitCenter" android:contentDescription="אשריכם ישראל" android:layout_marginEnd="7dp" />
  <TextView android:id="@+id/w_heb" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFF3D78E" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
  
</LinearLayout><TextView android:id="@+id/w_zl" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FFF3D78E" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textDirection="rtl" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/w_sl" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FFF6EFDC" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textDirection="rtl" />
<Chronometer android:id="@+id/w_cd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#BFE3ECF7" android:textSize="12sp" android:layout_marginStart="6dp" /></LinearLayout>
</LinearLayout>
